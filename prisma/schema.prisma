
generator client {
  provider = "prisma-client-js"
}

// Generates an ERD on `prisma generate`. Install with:
//   pnpm add -D prisma-erd-generator @mermaid-js/mermaid-cli
generator erd {
  provider = "prisma-erd-generator"
  output   = "./schema.svg"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vehicul {
  id              Int      @id @default(autoincrement())
  syncedAt        DateTime @default(now())

  // The plate is kept split, as in the first two "Nr. înmatriculare" columns
  // ("MRZ" + "40"); that pair is also how the soferi sheet references a
  // vehicle, so it is the join key on import. The sheet's 3rd
  // "Nr. înmatriculare" column (a hand-written display form) is ignored.
  litere          String                              // "Nr. înmatriculare" (1st col)
  cifre           String                              // "Nr. înmatriculare" (2nd col) — not always numeric ("f/n")
  nrInventar      Int      @unique                    // "Nr. Inventar"
  nrGaraj         Int      @unique                    // "Nr. Garaj"
  tip             String                              // "Destinatia"      — Tractor, Excavator, ...
  model           String                              // "Marcă / Model"   — MTZ-82, ...
  anProducere     Int?                                // "An fabricație"   — blank for a few old vehicles
  kmActuali       Int?                                // "Km actuali"
  sector          String?                             // "p63," — Ciocana (5), SBO, Repartizare, ...
  utilajeAuxiliare String?                            // "Utilaje auxiliare"
  lucrariLunaViitoare String?                         // "Lucrari necesate efectuat luna viitoare"

  soferi         Sofer[]         @relation("VehiculSofer")

  @@unique([litere, cifre])
}

model Sofer {
  id       Int      @id @default(autoincrement())
  syncedAt DateTime @default(now())

  cod                Int     @unique                  // "Nr. de pontaj"
  nume               String                           // "Nume Prenume"
  functie            String?                          // "Funcție"
  telefon            String?                          // "Telefon"
  sector             String?                          // "Sector"
  marimeHaina        String?                          // "Mărime haină"        — e.g. "52-53"
  marimeIncaltaminte String?                          // "Mărime încalțăminte"
  observatii         String?                          // "Observații"

  // EIP (protective equipment) issue dates. The sheet's "Urm. <item>" columns
  // are spreadsheet formulas (issue date + validity, and often #VALUE!), so
  // they are derived at the app layer rather than stored. A blank or
  // "NU E NEVOE" cell imports as null.
  eipScurta          DateTime?                        // "Scurtă"
  eipIncaltaminte    DateTime?                        // "Încălțăminte"
  eipCostum          DateTime?                        // "Costum"
  eipPantaloni       DateTime?                        // "Pantaloni"
  eipVestaAvertizare DateTime?                        // "Vestă avertizare"

  vehicule Vehicul[] @relation("VehiculSofer")
}