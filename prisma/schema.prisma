// Dates are stored as "YYYY-MM-DD" ISO strings.
// It reads chronologically in SQLite 
// and it is what <input type="date"> reads and writes.

generator client {
  provider = "prisma-client-js"
}

// Generates an ERD on `prisma generate`. Install with:
//   pnpm add -D prisma-erd-generator @mermaid-js/mermaid-cli
generator erd {
  provider = "prisma-erd-generator"
  output   = "./schema.svg"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vehicul {
  id        Int      @id @default(autoincrement())
  updatedAt DateTime @default(now()) @updatedAt

  nrInmatriculare     String  @unique // e.g. "MRZ 40"; suffixes may be non-numeric ("f/n")
  nrInventar          Int     @unique // "Nr. Inventar"
  nrGaraj             Int     @unique // "Nr. Garaj"
  tip                 String // "Destinatia"      — Tractor, Excavator, ...
  model               String // "Marcă / Model"   — MTZ-82, ...
  anProducere         Int? // "An fabricație"   — blank for a few old vehicles
  kmActuali           Int? // "Km actuali"
  sector              String? // "p63," — Ciocana (5), SBO, Repartizare, ...
  utilajeAuxiliare    String? // "Utilaje auxiliare"
  lucrariLunaViitoare String? // "Lucrari necesate efectuat luna viitoare"

  soferi         Sofer[]                    @relation("VehiculSofer")
  bonuri         BonEliberare[]
  acteDefectiune ActDefectiuneData[]
  comenzi        ComandaMaterialeMaterial[]
  anvelopeLuni   AnvelopaLuni[]
  anvelopeKm     AnvelopaKm[]
  acumulatoare   Acumulator[]

}

model Sofer {
  id        Int      @id @default(autoincrement())
  updatedAt DateTime @default(now()) @updatedAt

  cod                Int     @unique // "Nr. de pontaj"
  nume               String // "Nume Prenume"
  functie            String? // "Funcție"
  telefon            String? // "Telefon"
  sector             String? // "Sector"
  marimeHaina        String? // "Mărime haină"        — e.g. "52-53"
  marimeIncaltaminte String? // "Mărime încalțăminte"
  observatii         String? // "Observații"

  // EIP (protective equipment) issue dates (ISO YYYY-MM-DD)
  eipScurta          String? // "Scurtă"
  eipIncaltaminte    String? // "Încălțăminte"
  eipCostum          String? // "Costum"
  eipPantaloni       String? // "Pantaloni"
  eipVestaAvertizare String? // "Vestă avertizare"

  vehicule       Vehicul[]           @relation("VehiculSofer")
  bonuri         BonEliberare[]
  acteDefectiune ActDefectiuneData[]
}

// A "bon de eliberare" — one issue slip: materials handed to one sofer for one
// vehicul on one day.
model BonEliberare {
  id        Int      @id @default(autoincrement())
  updatedAt DateTime @default(now()) @updatedAt

  // Issue date (ISO "YYYY-MM-DD")
  data String

  soferId   Int
  sofer     Sofer   @relation(fields: [soferId], references: [id])
  vehiculId Int
  vehicul   Vehicul @relation(fields: [vehiculId], references: [id])

  materiale BonEliberareMaterial[]
}

// One line on a bon. Kept as its own table rather than JSON so lines can be
// summed per material/month for the "fisa limita".
model BonEliberareMaterial {
  id Int @id @default(autoincrement())

  bonId Int
  bon   BonEliberare @relation(fields: [bonId], references: [id], onDelete: Cascade)

  // The material is a reference, not free text, so the same thing is spelled
  // the same way on every bon and the monthly roll-up can group by it. Lines
  // pin the material (no onDelete), so a material in use cannot be deleted.
  materialId Int
  material   MaterialeIntretinere @relation(fields: [materialId], references: [id])

  um        String // "l", "buc"
  cantitate Float

  // A material can appear at most once per bon
  @@unique([bonId, materialId])
}

// The catalogue of maintenance materials — the distinct things that can appear
// on a bon. Names are unique, and the app creates a row on the fly the first
// time a bon names something new, so the catalogue never blocks writing a bon.
model MaterialeIntretinere {
  id        Int      @id @default(autoincrement())
  updatedAt DateTime @default(now()) @updatedAt

  nume String @unique // "ULEI MOTOR 10W40"

  bonuri  BonEliberareMaterial[]
  facturi FacturaExpeditieMaterial[]
}

// A "factura de expeditie" — one delivery invoice: the materials received on
// one day, with the "cod nomenclator" and price each came under. It is what
// the bonuri are matched against at month end to resolve their price.
model FacturaExpeditie {
  id        Int      @id @default(autoincrement())
  updatedAt DateTime @default(now()) @updatedAt

  // Calendar date (ISO "YYYY-MM-DD")
  data String

  // "YYYY-MM", derived from `data`
  month String

  materiale FacturaExpeditieMaterial[]

  @@index([month])
}

// One line on a factura de expeditie.
model FacturaExpeditieMaterial {
  id Int @id @default(autoincrement())

  facturaId Int
  factura   FacturaExpeditie @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  // The document's "nume" column.
  materialId Int
  material   MaterialeIntretinere @relation(fields: [materialId], references: [id])

  // "cod nomenclator", e.g. "2111121795".
  nrCart     String
  um         String // "L", "KG"
  cantitate  Float
  pretUnitar Float // price for one `um`

  // A material can appear at most once per factura
  @@unique([facturaId, materialId])
}

// A file the app generated and uploaded to Drive — the record of what was
// produced, independent of which document type it is. On re-generate the row
// is updated in place, so it always describes the file it currently points
// at (never an orphaned second row referencing nothing).
model GeneratedDocument {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  kind String // e.g. "fisaLimita"
  nume String // Drive file name

  driveFileId String @unique
  driveUrl    String

  fisaLimita       FisaLimitaDoc?
  actDefectiune    ActDefectiuneDoc?
  comandaMateriale ComandaMaterialeDoc?
}

// One month's "fisa limita" — at most one per month, re-generation updates
// the same row.
model FisaLimitaDoc {
  id Int @id @default(autoincrement())

  month String @unique // "YYYY-MM"

  documentId Int               @unique
  document   GeneratedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// A saved "act de constatare a defectiunilor" — the form the document is
// rendered from. Its three tables are stored as JSON rather than as line
// tables of their own: unlike a bon's materials, they are never summed across
// documents, and a piece names a product from the CSV catalogue, which has no
// table here to point at. dto.ts is the only place that parses it.
//
// Only what nothing else answers for is stored. The "Informatie activ" block
// comes off the vehicul and a piesa's name and UM off its nomenclator code, all
// resolved on read by derived.ts — so an act always prints today's fleet and
// catalogue rather than a copy taken the day it was written.
model ActDefectiuneData {
  id        Int      @id @default(autoincrement())
  updatedAt DateTime @default(now()) @updatedAt

  // Calendar date (ISO "YYYY-MM-DD")
  data String

  vehiculId Int
  vehicul   Vehicul @relation(fields: [vehiculId], references: [id])

  // The sofer the act names ("Avizat"), and — through the vehicul's `tip` —
  // the "funcția" printed next to the name; see infoSofer in server/src/derived.ts.
  soferId Int
  sofer   Sofer @relation(fields: [soferId], references: [id])

  // JSON arrays — "Lista defecțiunilor", "Lista pieselor de schimb" and
  // "Lista lucrărilor de reparații necesare".
  defectiuni  String
  pieseSchimb String
  lucrari     String

  // A comanda can gather the pieces requested by several acts. The relation
  // deliberately lives on the documents, rather than copying their pieces
  // into ComandaMaterialeMaterial: edits to an act are reflected in the
  // comanda preview and in a newly generated document.
  comenziMateriale ComandaMaterialeData[]

  doc ActDefectiuneDoc?
}

// One act's generated document — at most one per act, re-generation updates
// the same row. Mirrors FisaLimitaDoc, keyed by the act instead of a month.
model ActDefectiuneDoc {
  id Int @id @default(autoincrement())

  actId Int               @unique
  act   ActDefectiuneData @relation(fields: [actId], references: [id], onDelete: Cascade)

  documentId Int               @unique
  document   GeneratedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// A saved "comanda de materiale" — the ~daily materials order the document is
// rendered from. It has no vehicul of its own: one comanda covers the 2-3 acte
// de defectiune written that day, so the vehicul is per line.
model ComandaMaterialeData {
  id        Int      @id @default(autoincrement())
  updatedAt DateTime @default(now()) @updatedAt

  // Calendar date (ISO "YYYY-MM-DD")
  data String

  // The acts whose piese de schimb are prepended to the manually entered
  // materials when this comanda is generated.
  acteDefectiune ActDefectiuneData[]
  materiale ComandaMaterialeMaterial[]

  doc ComandaMaterialeDoc?
}

// One line on a comanda. A real table rather than JSON like an act's tables:
// the line names the vehicul it is ordered for, and that is a row here — the
// document's "Specificația materialului" is its plate, resolved on read by
// derived.ts. The material itself stays free text plus its catalogue code, as
// on an act's piesa: that catalogue is the CSV, which has no table here.
model ComandaMaterialeMaterial {
  id Int @id @default(autoincrement())

  comandaId Int
  comanda   ComandaMaterialeData @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  // Lines pin the vehicul (no onDelete), so one named by a comanda cannot be
  // deleted — same rule as a bon's material.
  vehiculId Int
  vehicul   Vehicul @relation(fields: [vehiculId], references: [id])

  // The row's own number in the document's table, assigned from the order the
  // lines were sent in. Stored rather than read off the row ids: Prisma's
  // nested create does not hand them out in input order.
  nr Int

  nume      String // "Denumirea materialului"
  cod       String // "Nomenclator D365" — blank for a material the catalogue lacks
  um        String // "buc", "set", "l"
  cantitate Float
}

// One physical tire currently mounted on a vehicul, replaced on a fixed
// calendar schedule ("anvelope_part1.csv"). Km-based tires are AnvelopaKm
// instead — the two schedules never mix on one vehicul, but each vehicul has
// many wheels, so this is one row per tire, not per vehicul.
model AnvelopaLuni {
  id        Int      @id @default(autoincrement())
  updatedAt DateTime @default(now()) @updatedAt

  vehiculId Int
  vehicul   Vehicul @relation(fields: [vehiculId], references: [id])

  model          String? // "model anvelopa" — blank for a few vehicles in the source data
  dataInstalarii String  // "data instalarii" (ISO "YYYY-MM-DD")
  normaLuni      Int     // "luni nominal" — replace `normaLuni` months after dataInstalarii
}

// One physical tire currently mounted on a vehicul, replaced after a traveled
// distance ("anvelope_part2.csv"). Mirrors AnvelopaLuni; the source's
// "kilometraj actual schimb" column is not stored here — it repeats
// Vehicul.kmActuali on every row and is resolved on read instead (derived.ts),
// same convention as ActDefectiuneData.
model AnvelopaKm {
  id        Int      @id @default(autoincrement())
  updatedAt DateTime @default(now()) @updatedAt

  vehiculId Int
  vehicul   Vehicul @relation(fields: [vehiculId], references: [id])

  model          String? // "model anvelopa"
  dataInstalarii String  // "data instalarii" (ISO "YYYY-MM-DD")
  kmInstalare    Int     // "Km la instalare"
  normaKm        Int     // "norma de uzura" — replace after `normaKm` km since kmInstalare
}

// One physical accumulator currently installed on a vehicul, replaced on a
// fixed calendar schedule ("acumulatoare.csv"). Mirrors AnvelopaLuni; a
// vehicul can have several accumulators, so this is one row per accumulator,
// not per vehicul.
model Acumulator {
  id        Int      @id @default(autoincrement())
  updatedAt DateTime @default(now()) @updatedAt

  vehiculId Int
  vehicul   Vehicul @relation(fields: [vehiculId], references: [id])

  model          String? // "model acum" — blank for a couple vehicles in the source data
  dataInstalarii String  // "data instalarii" (ISO "YYYY-MM-DD")
  normaLuni      Int     // "luni nominal" — replace `normaLuni` months after dataInstalarii
}

// One comanda's generated document — at most one per comanda, re-generation
// updates the same row. Mirrors ActDefectiuneDoc.
model ComandaMaterialeDoc {
  id Int @id @default(autoincrement())

  comandaId Int                  @unique
  comanda   ComandaMaterialeData @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  documentId Int               @unique
  document   GeneratedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}
