// Dates are stored as "YYYY-MM-DD" ISO strings.
// It reads chronologically in SQLite 
// and it is what <input type="date"> reads and writes.

generator client {
  provider = "prisma-client-js"
}

// Generates an ERD on `prisma generate`. Install with:
//   pnpm add -D prisma-erd-generator @mermaid-js/mermaid-cli
generator erd {
  provider = "prisma-erd-generator"
  output   = "./schema.svg"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vehicul {
  id       Int      @id @default(autoincrement())
  syncedAt DateTime @default(now()) @updatedAt

  // The plate is kept split, as in the first two "Nr. înmatriculare" columns
  // ("MRZ" + "40"); that pair is also how the soferi sheet references a
  // vehicle, so it is the join key on import. The sheet's 3rd
  // "Nr. înmatriculare" column (a hand-written display form) is ignored.
  litere              String // "Nr. înmatriculare" (1st col)
  cifre               String // "Nr. înmatriculare" (2nd col) — not always numeric ("f/n")
  nrInventar          Int     @unique // "Nr. Inventar"
  nrGaraj             Int     @unique // "Nr. Garaj"
  tip                 String // "Destinatia"      — Tractor, Excavator, ...
  model               String // "Marcă / Model"   — MTZ-82, ...
  anProducere         Int? // "An fabricație"   — blank for a few old vehicles
  kmActuali           Int? // "Km actuali"
  sector              String? // "p63," — Ciocana (5), SBO, Repartizare, ...
  utilajeAuxiliare    String? // "Utilaje auxiliare"
  lucrariLunaViitoare String? // "Lucrari necesate efectuat luna viitoare"

  soferi Sofer[]        @relation("VehiculSofer")
  bonuri BonEliberare[]

  @@unique([litere, cifre])
}

model Sofer {
  id       Int      @id @default(autoincrement())
  syncedAt DateTime @default(now()) @updatedAt

  cod                Int     @unique // "Nr. de pontaj"
  nume               String // "Nume Prenume"
  functie            String? // "Funcție"
  telefon            String? // "Telefon"
  sector             String? // "Sector"
  marimeHaina        String? // "Mărime haină"        — e.g. "52-53"
  marimeIncaltaminte String? // "Mărime încalțăminte"
  observatii         String? // "Observații"

  // EIP (protective equipment) issue dates (ISO YYYY-MM-DD)
  eipScurta          String? // "Scurtă"
  eipIncaltaminte    String? // "Încălțăminte"
  eipCostum          String? // "Costum"
  eipPantaloni       String? // "Pantaloni"
  eipVestaAvertizare String? // "Vestă avertizare"

  vehicule Vehicul[]      @relation("VehiculSofer")
  bonuri   BonEliberare[]
}

// A "bon de eliberare" — one issue slip: materials handed to one sofer for one
// vehicul on one day.
model BonEliberare {
  id       Int      @id @default(autoincrement())
  syncedAt DateTime @default(now()) @updatedAt

  // Issue date (ISO "YYYY-MM-DD")
  data String

  soferId   Int
  sofer     Sofer   @relation(fields: [soferId], references: [id])
  vehiculId Int
  vehicul   Vehicul @relation(fields: [vehiculId], references: [id])

  materiale BonEliberareMaterial[]
}

// One line on a bon. Kept as its own table rather than JSON so lines can be
// summed per material/month for the "fisa limita".
model BonEliberareMaterial {
  id Int @id @default(autoincrement())

  bonId Int
  bon   BonEliberare @relation(fields: [bonId], references: [id], onDelete: Cascade)

  // The material is a reference, not free text, so the same thing is spelled
  // the same way on every bon and the monthly roll-up can group by it. Lines
  // pin the material (no onDelete), so a material in use cannot be deleted.
  materialId Int
  material   MaterialeIntretinere @relation(fields: [materialId], references: [id])

  // "cod nomenclator", e.g. "2111121795". Unknown when the bon is written; it
  // is matched by the material's name against the "Factura de expeditie" at
  // month end. It stays on the line rather than on the material: the same
  // material can be delivered under different codes.
  nrCart    String?
  um        String // "l", "buc"
  cantitate Float
}

// The catalogue of maintenance materials — the distinct things that can appear
// on a bon. Names are unique, and the app creates a row on the fly the first
// time a bon names something new, so the catalogue never blocks writing a bon.
model MaterialeIntretinere {
  id       Int      @id @default(autoincrement())
  syncedAt DateTime @default(now()) @updatedAt

  nume String @unique // "ULEI MOTOR 10W40"

  bonuri  BonEliberareMaterial[]
  facturi FacturaExpeditieMaterial[]
}

// A "factura de expeditie" — one delivery invoice: the materials received on
// one day, with the "cod nomenclator" and price each came under. It is what
// the bonuri are matched against at month end to fill in their nrCart.
model FacturaExpeditie {
  id       Int      @id @default(autoincrement())
  syncedAt DateTime @default(now()) @updatedAt

  // Calendar date (ISO "YYYY-MM-DD")
  data String

  // "YYYY-MM", derived from `data`. Enforces one factura per month at the DB
  // level and makes "the factura for month X" an index hit.
  luna String @unique

  materiale FacturaExpeditieMaterial[]
}

// One line on a factura de expeditie.
model FacturaExpeditieMaterial {
  id Int @id @default(autoincrement())

  facturaId Int
  factura   FacturaExpeditie @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  // The document's "nume" column, kept as a reference so a factura and a bon
  // spell the same material the same way. Lines pin the material (no
  // onDelete), so a material in use cannot be deleted.
  materialId Int
  material   MaterialeIntretinere @relation(fields: [materialId], references: [id])

  // "cod nomenclator", e.g. "2111121795" — unlike on a bon line, it is known
  // here: the factura is where it comes from.
  nrCart     String
  um         String // "L", "KG"
  cantitate  Float
  pretUnitar Float // price for one `um`
}

// A file the app generated and uploaded to Drive — the record of what was
// produced, independent of which document type it is. On re-generate the row
// is updated in place, so it always describes the file it currently points
// at (never an orphaned second row referencing nothing).
model GeneratedDocument {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  kind String // e.g. "fisaLimita"
  nume String // Drive file name

  driveFileId String @unique
  driveUrl    String

  fisaLimita FisaLimitaDoc?
}

// One month's "fisa limita" — at most one per month, re-generation updates
// the same row.
model FisaLimitaDoc {
  id Int @id @default(autoincrement())

  luna String @unique // "YYYY-MM"

  documentId Int               @unique
  document   GeneratedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}
