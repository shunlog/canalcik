GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Templates fetched by `pnpm run fetch`: the share URL of each source document,
# a native Google Doc/Sheet shared with "anyone with the link". No OAuth is
# involved. Optional: with GOOGLE_API_KEY set they are exported through the
# Drive API (the key must not be restricted to HTTP referrers), otherwise
# through docs.google.com's keyless export endpoint.
GOOGLE_API_KEY=
TEMPLATE_URL_COMANDA_MATERIALE=https://docs.google.com/document/d/<file-id>/edit
TEMPLATE_URL_ACT_DEFECTIUNE=https://docs.google.com/document/d/<file-id>/edit
TEMPLATE_URL_FISA_LIMITA=https://docs.google.com/spreadsheets/d/<file-id>/edit
DATABASE_URL="file:../data/dev.db"
PORT=8787
DISABLE_ERD=true
