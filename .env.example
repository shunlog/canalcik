GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optional: with GOOGLE_API_KEY set, the templates from Drive are downloaded
# using Drive API (more robust),
# otherwise through docs.google.com's keyless export endpoint
GOOGLE_API_KEY=

TEMPLATE_URL_COMANDA_MATERIALE=https://docs.google.com/document/d/<file-id>/edit
TEMPLATE_URL_ACT_DEFECTIUNE=https://docs.google.com/document/d/<file-id>/edit
TEMPLATE_URL_FISA_LIMITA=https://docs.google.com/spreadsheets/d/<file-id>/edit

### --- Deployment Settings ---

# All three must be absolute paths. In dev they point inside the (gitignored)
# data/ dir; in prod they are overridden by docker-compose.yml to point at /data
# inside the container.
TEMPLATES_DIR=/absolute/path/to/repo/data/templates
DATABASE_URL="file:/absolute/path/to/repo/data/db/dev.db"
# where the OAuth token from `pnpm run auth` is stored
#TOKEN_PATH=

#HOST=localhost
PORT=8787
DISABLE_ERD=true

# Prod only (docker-compose.yml): the host uid/gid owning deploy/, so files the
# container writes there don't need sudo to touch. `id -u`, `id -g`.
APP_UID=1000
APP_GID=1000
