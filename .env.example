GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Folder holding the Drive templates fetched by `pnpm run fetch`.
TEMPLATES_FOLDER_ID=your-drive-folder-id
# Optional: pin the folder generated documents are uploaded to. Left unset, the
# app finds (or creates) a folder named "canalcik" on the authorized account.
GOOGLE_FOLDER_ID=
DATABASE_URL="file:../data/dev.db"
PORT=8787
DISABLE_ERD=true

# Optional: override the OAuth callback the server sends the browser back to.
# E.g. if using Caddy, it proxies the request to the server via http,
# so the server guesses that the redirect URI is http://... instead of https://...
# hence you need to set this URL explicitly to https://...
GOOGLE_REDIRECT_URI=https://<your-domain>/api/drive/callback
