# Imported from /etc/caddy/Caddyfile. Placeholders come from
# /etc/caddy/canalcik.env — see deploy/README.md.

{$CANALCIK_DOMAIN} {
	# /api/* goes to the Hono process; everything else is the built SPA. This
	# mirrors the Vite dev proxy, so fetch("/api/...") works unchanged.
	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		# Copied out of the image by `docker compose run --rm publish`; caddy
		# reads it as "other", so it has to stay world-readable.
		root * /srv/canalcik/web

		# vite content-hashes everything under assets/, so those can be cached
		# forever; index.html names them and must never be. Both matchers run
		# against the request path, before try_files rewrites it.
		@hashed path /assets/*
		@page not path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header @page Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}

	# The API has no auth of its own; this is the only thing in front of it.
	basic_auth {
		{$CANALCIK_BASICAUTH_USERNAME} {$CANALCIK_BASICAUTH_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	encode zstd gzip
}
