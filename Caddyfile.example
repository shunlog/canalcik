# Not read by anything — copy this block into the main Caddyfile on the server
# and reload. Kept here so the proxy side of the deployment is documented with
# the code; re-copy it if it ever changes.

canalcik.example.com {
	basic_auth {
		# caddy hash-password
		user $2a$14$replace-with-a-real-bcrypt-hash
	}

	encode zstd gzip

	handle /api/* {
		# The API expects the /api prefix, so don't strip it.
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		root * /srv/canalcik/deploy/www
		try_files {path} /index.html
		file_server

		# The SPA shell (including every route that try_files falls back to it)
		# keeps a stable filename, so it must revalidate on every load rather
		# than being served from a heuristically-cached stale copy.
		header Cache-Control "no-cache"

		# Vite content-hashes these, so the URL changes whenever the content
		# does and they can be cached indefinitely.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}
}
